<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PoruBot Agent</AssemblyName>
    <ApplicationIcon>../PoruBot.ico</ApplicationIcon>
    <Version>2.4.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <EmbeddedResource Include="../PoruBot.ico" LogicalName="PoruBot.ico" />
  </ItemGroup>
</Project>
